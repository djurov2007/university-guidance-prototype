# Mock is the default. OpenAI integration is opt-in after explicit approval.
APP_MODE=mock
# Local mock needs no API key, database URL, or cloud account.
# Server secrets belong in .env.local or the host secret store, never NEXT_PUBLIC_*.
NEXT_TELEMETRY_DISABLED=1

# Step 8: internal AI adapter; defaults stay offline. No secret value belongs here.
AI_PROVIDER=mock
AI_MODEL=gpt-6-luna
AI_LIVE_APPROVED=false
AI_DOCUMENT_ANALYSIS=false
# Live also requires a trusted server spend guard and explicit human approval.

# Local preview. HTTPS mode additionally requires one exact public origin.
PROTOTYPE_TRANSPORT=local_http
# PROTOTYPE_PUBLIC_ORIGIN=https://example.up.railway.app
# Local control DB must remain within .local/ or .cache/. A cloud absolute path
# also requires HTTPS and must remain inside PROTOTYPE_PERSISTENT_ROOT.
# PROTOTYPE_CONTROL_DB=/data/control.sqlite
# PROTOTYPE_PERSISTENT_ROOT=/data
# Optional live demo ceiling may only lower the fixed 200-attempt cap.
# PROTOTYPE_AI_ATTEMPT_CEILING=200
# Upload stays disabled. Paid demo caps are fixed in server code: 200 attempts,
# USD 2 total, USD 0.50/day, USD 0.10/session and USD 0.01/request.
# Environment variables cannot increase them.
# Use npm run ai:status for an offline check. npm run ai:live sends one paid
# synthetic attempt and must only be run after explicit spending approval.
